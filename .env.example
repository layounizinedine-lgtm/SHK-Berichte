# ---------------------------------------------------------------------------
# SHK-Berichte – Konfiguration
# Diese Datei nach ".env" kopieren und ausfüllen. Die .env wird NICHT
# eingecheckt. Benutzer der App müssen nie einen Schlüssel eingeben –
# die KI-Anbindung liegt komplett auf dem Server.
# ---------------------------------------------------------------------------

# Schlüssel für die Claude-API (https://console.anthropic.com).
# Ohne Schlüssel läuft die App im "Fachmodus offline": Die eingebaute
# SHK-Fachsprache-Engine formuliert weiterhin um, nur ohne KI-Feinschliff.
ANTHROPIC_API_KEY=

# Modell für die Texterzeugung (Standard: claude-sonnet-5)
SHK_AI_MODEL=claude-sonnet-5

# Nur ändern, wenn die API über einen eigenen Endpunkt/Proxy läuft.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Port des Webservers
PORT=3000

# Zufälliges Geheimnis für Sitzungs-Cookies (z. B. `openssl rand -hex 32`).
# Wird automatisch erzeugt und in data/ gespeichert, wenn leer.
SESSION_SECRET=

# Auf "1" setzen, wenn die App hinter HTTPS läuft (setzt Secure-Cookies).
SECURE_COOKIES=0

# Auf "1" setzen, um die Registrierung neuer Konten zu sperren.
DISABLE_REGISTRATION=0

# Ablageort der Datenbank (Standard: ./data)
SHK_DATENVERZEICHNIS=
